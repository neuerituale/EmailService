<?php

namespace ProcessWire;

class ProcessEmailLog extends Process implements Module
{
	const perPage = 20;

	/** Preview widths by size name */
	const previewSizes = ['mobile' => '377px', 'tablet' => '770px', 'desktop' => '100%'];

	/** Preview formats */
	const previewFormats = ['html', 'text'];

	/**
	 * Return module info array.
	 *
	 * @return array
	 */
	public static function getModuleInfo(): array
	{
		return [
			'title' => 'Email Log',
			'version' => '3.0.0',
			'summary' => 'Browse sent emails, preview templates and resend.',
			'icon' => 'envelope',
			'singular' => true,
			'autoload' => false,
			'permission' => 'email-log-view',
			'permissions' => [
				'email-log-view' => 'View email log',
			],
			'page' => [
				'name' => 'email-log',
				'parent' => 'setup',
				'title' => 'Email Log',
			],
			'requires' => ['EmailService'],
		];
	}

	/* ***** Overview *** */

	/**
	 * Display the paginated email log listing.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___execute(): string
	{
		$this->headline(__('Email Log'));
		$this->browserTitle(__('Email Log'));
		$this->showDependencyWarnings();

		$input = $this->wire('input');
		$sanitizer = $this->wire('sanitizer');

		$filterStatus = $sanitizer->text($input->get('status') ?? '');
		if (!in_array($filterStatus, ['sent', 'failed'])) $filterStatus = '';

		$filterTemplate = $sanitizer->text($input->get('template') ?? '');
		$currentPg = max(1, (int) $input->pageNum());

		$total = $this->queryCount($filterStatus, $filterTemplate);
		$entries = $this->queryEntries($filterStatus, $filterTemplate, $currentPg);

		$pager = new PaginatedArray();
		$pager->setTotal($total);
		$pager->setLimit(self::perPage);
		$pager->setStart(($currentPg - 1) * self::perPage);

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$templates = $emailService->getRegisteredTemplates();

		$usedTemplates = $this->queryDistinctTemplates();

		$tpl = new TemplateFile(__DIR__ . '/views/execute.php');
		$tpl->setArray([
			'entries' => $entries,
			'filterStatus' => $filterStatus,
			'filterTemplate' => $filterTemplate,
			'templates' => $templates,
			'usedTemplates' => $usedTemplates,
			'languages' => $emailService->getLanguages(),
			'pager' => $pager,
			'total' => $total,
			'process' => $this,
			'adminPage' => $this->wire('page'),
		]);

		return $tpl->render();
	}

	/* ***** Detail *** */

	/**
	 * Display a single email log entry.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___executeDetail(): string
	{
		$id = (int) $this->wire('input')->get('id');
		$entry = $this->getEntry($id);

		if (!$entry) {
			$this->error(__('Entry not found.'));
			$this->wire('session')->redirect($this->wire('page')->url);
			return '';
		}

		$this->headline(__('Email Detail'));
		$this->browserTitle(__('Email Detail'));
		$this->showDependencyWarnings();
		$this->addLogBreadcrumb();

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$state = $this->getDetailState();

		$tpl = new TemplateFile(__DIR__ . '/views/detail.php');
		$tpl->setArray([
			'entry' => $entry,
			'state' => $state,
			'sizes' => self::previewSizes,
			'templates' => $emailService->getRegisteredTemplates(),
			'languages' => $emailService->getLanguages(),
			'iframeUrl' => $this->wire('page')->url . 'iframe/?' . http_build_query(['id' => (int) $entry['id'], 'format' => $state['format']]),
			'process' => $this,
			'adminPage' => $this->wire('page'),
		]);

		return $tpl->render();
	}

	/**
	 * Get the sanitized view settings of the detail page (format and device).
	 *
	 * @return array{format: string, size: string}
	 * @throws WireException
	 */
	public function getDetailState(): array
	{
		$input = $this->wire('input');
		$sanitizer = $this->wire('sanitizer');

		$format = $sanitizer->name((string) $input->get('format'));
		if (!in_array($format, self::previewFormats, true)) $format = 'html';

		$size = $sanitizer->name((string) $input->get('size'));
		if (!isset(self::previewSizes[$size])) $size = 'desktop';

		return ['format' => $format, 'size' => $size];
	}

	/**
	 * Get the label of a language stored in the log (title, else name).
	 *
	 * @param string $name Language name
	 * @return string Empty if no language is stored
	 * @throws WireException
	 */
	public function getLanguageLabel(string $name): string
	{
		if ($name === '') return '';

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		foreach ($emailService->getLanguages() as $language) {
			if ($language->name === $name) return (string) $language->get('title') ?: $language->name;
		}

		// language was deleted in the meantime
		return $name;
	}

	/* ***** Resend *** */

	/**
	 * Handle resend POST request for an existing log entry.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___executeResend(): string
	{
		$this->wire('session')->redirect($this->processResend());
		return '';
	}

	/**
	 * Resend the posted log entry if the request is valid.
	 *
	 * Requires a POST with submit_resend, a valid CSRF token and an existing entry id.
	 *
	 * @return string URL to redirect to
	 * @throws WireException
	 */
	public function processResend(): string
	{
		$input = $this->wire('input');
		$session = $this->wire('session');
		$adminUrl = $this->wire('page')->url;

		if (!$input->post('submit_resend')) return $adminUrl;

		$id = (int) $input->post('id');
		$detailUrl = $id > 0 ? $adminUrl . 'detail/?id=' . $id : $adminUrl;

		if (!$session->CSRF->hasValidToken()) {
			$this->error(__('Invalid or expired form token, the email was not resent. Please try again.'));
			return $detailUrl;
		}

		$entry = $id > 0 ? $this->getEntry($id) : false;
		if (!$entry) {
			$this->error(__('Entry not found.'));
			return $adminUrl;
		}

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');

		if ($emailService->resend($entry)) {
			$this->message(sprintf(__('Email to %s resent successfully.'), $entry['to_email']));
		} else {
			$this->error(sprintf(__('Failed to resend email to %s.'), $entry['to_email']));
		}

		return $detailUrl;
	}

	/* ***** Delete a single entry *** */

	/**
	 * Handle the delete POST request for a single log entry.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___executeDeleteEntry(): string
	{
		$this->wire('session')->redirect($this->processDeleteEntry());
		return '';
	}

	/**
	 * Delete a single log entry (superusers only, CSRF protected).
	 *
	 * @return string URL to redirect to: the overview after deleting, else the detail page
	 * @throws WireException
	 */
	public function processDeleteEntry(): string
	{
		$input = $this->wire('input');
		$session = $this->wire('session');
		$adminUrl = $this->wire('page')->url;

		if (!$input->post('submit_delete_entry')) return $adminUrl;

		$id = (int) $input->post('id');
		$detailUrl = $id > 0 ? $adminUrl . 'detail/?id=' . $id : $adminUrl;

		if (!$this->wire('user')->isSuperuser()) {
			$this->error(__('You do not have permission to delete email logs.'));
			return $detailUrl;
		}

		if (!$session->CSRF->hasValidToken()) {
			$this->error(__('Invalid or expired form token, the entry was not deleted. Please try again.'));
			return $detailUrl;
		}

		$entry = $id > 0 ? $this->getEntry($id) : false;
		if (!$entry) {
			$this->error(__('Entry not found.'));
			return $adminUrl;
		}

		if (!$this->deleteEntry($id)) {
			$this->error(__('The entry could not be deleted.'));
			return $detailUrl;
		}

		$this->message(sprintf(__('Email log entry for %s deleted.'), $entry['to_email']));
		return $adminUrl;
	}

	/* ***** Delete *** */

	/**
	 * Delete email log entries matching the active filter (superuser only).
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___executeDelete(): string
	{
		$input = $this->wire('input');
		$session = $this->wire('session');
		$sanitizer = $this->wire('sanitizer');
		$adminPage = $this->wire('page');

		if (!$this->wire('user')->isSuperuser()) {
			throw new WirePermissionException(__('You do not have permission to delete email logs.'));
		}

		if (!$input->post('submit_delete') || !$session->CSRF->hasValidToken()) {
			$session->redirect($adminPage->url);
			return '';
		}

		$filterStatus = $sanitizer->text($input->post('status') ?? '');
		if (!in_array($filterStatus, ['sent', 'failed'])) $filterStatus = '';
		$filterTemplate = $sanitizer->text($input->post('template') ?? '');

		$deleted = $this->deleteEntries($filterStatus, $filterTemplate);

		$this->message(sprintf(__('%d email log entries deleted.'), $deleted));

		$params = [];
		if ($filterStatus) $params['status'] = $filterStatus;
		if ($filterTemplate) $params['template'] = $filterTemplate;
		$queryString = $params ? '?' . http_build_query($params) : '';

		$session->redirect($adminPage->url . $queryString);
		return '';
	}

	/* ***** Preview *** */

	/**
	 * Show a template preview using registered sample data.
	 *
	 * Size, format and language are read from the query string and kept when
	 * switching templates, so all variants can be checked quickly.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function ___executePreview(): string
	{
		$this->headline(__('Template Preview'));
		$this->browserTitle(__('Template Preview'));
		$this->addLogBreadcrumb();
		$this->showDependencyWarnings();

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$templates = $emailService->getRegisteredTemplates();
		$state = $this->getPreviewState($templates);

		$canRender = false;
		$hasTextTemplate = false;
		if ($state['template'] !== '') {
			$language = $state['language'] ?: null;
			$sampleData = $emailService->getSampleData($state['template'], $language);
			$canRender = $emailService->render($state['template'], $sampleData, $language) !== '';
			$hasTextTemplate = $emailService->hasTextTemplate($state['template']);
		}

		$tpl = new TemplateFile(__DIR__ . '/views/preview.php');
		$tpl->setArray([
			'templates' => $templates,
			'languages' => $emailService->getLanguages(),
			'state' => $state,
			'sizes' => self::previewSizes,
			'canRender' => $canRender,
			'hasTextTemplate' => $hasTextTemplate,
			'process' => $this,
			'adminPage' => $this->wire('page'),
		]);

		return $tpl->render();
	}

	/**
	 * Get the sanitized preview state from the query string.
	 *
	 * Unknown values fall back to the defaults: no template, html, desktop and
	 * the current user language (0 without LanguageSupport).
	 *
	 * @param array $templates Registered templates
	 * @return array{template: string, format: string, size: string, language: int}
	 * @throws WireException
	 */
	public function getPreviewState(array $templates): array
	{
		$input = $this->wire('input');
		$sanitizer = $this->wire('sanitizer');

		$template = $sanitizer->text((string) $input->get('template'));
		if (!isset($templates[$template])) $template = '';

		$format = $sanitizer->name((string) $input->get('format'));
		if (!in_array($format, self::previewFormats, true)) $format = 'html';

		$size = $sanitizer->name((string) $input->get('size'));
		if (!isset(self::previewSizes[$size])) $size = 'desktop';

		return [
			'template' => $template,
			'format' => $format,
			'size' => $size,
			'language' => $this->getPreviewLanguageId($input->get('language')),
		];
	}

	/**
	 * Resolve the requested preview language to an existing language id.
	 *
	 * @param mixed $value Language id from the query string
	 * @return int Language id, current user language if invalid, 0 without LanguageSupport
	 * @throws WireException
	 */
	protected function getPreviewLanguageId(mixed $value): int
	{
		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$languages = $emailService->getLanguages();
		if (!count($languages)) return 0;

		$id = is_string($value) && ctype_digit($value) ? (int) $value : 0;
		if (isset($languages[$id])) return $id;

		$current = $this->wire('user')->language;
		return $current instanceof Language && isset($languages[$current->id])
			? $current->id
			: (int) array_key_first($languages);
	}

	/**
	 * Build the URL of the preview page for the given state.
	 *
	 * @param array $state See getPreviewState()
	 * @return string
	 * @throws WireException
	 */
	public function getPreviewUrl(array $state): string
	{
		return $this->wire('page')->url . 'preview/?' . http_build_query($this->getStateParams($state));
	}

	/**
	 * Build the URL of the preview iframe for the given state.
	 *
	 * @param array $state See getPreviewState()
	 * @return string
	 * @throws WireException
	 */
	public function getIframeUrl(array $state): string
	{
		$params = $this->getStateParams($state);
		unset($params['size']);
		return $this->wire('page')->url . 'iframe/?' . http_build_query($params);
	}

	/**
	 * Get the query parameters for a preview state, without empty values.
	 *
	 * @param array $state
	 * @return array
	 */
	protected function getStateParams(array $state): array
	{
		return array_filter([
			'template' => (string) ($state['template'] ?? ''),
			'format' => (string) ($state['format'] ?? ''),
			'size' => (string) ($state['size'] ?? ''),
			'language' => (int) ($state['language'] ?? 0),
		]);
	}

	/**
	 * Render iframe content for email preview or template preview.
	 *
	 * @return void
	 * @throws WireException
	 * @throws WirePermissionException
	 */
	public function ___executeIframe(): void
	{
		echo $this->renderIframe();
		exit;
	}

	/**
	 * Render the iframe document: a logged email (?id=) or a template preview
	 * (?template=&format=&language=).
	 *
	 * @return string Empty if nothing matches
	 * @throws WireException
	 */
	public function renderIframe(): string
	{
		$input = $this->wire('input');

		$id = (int) $input->get('id');
		if ($id > 0) {
			$entry = $this->getEntry($id);
			if (!$entry) return '';
			return $input->get('format') === 'text'
				? $this->renderTextDocument((string) $entry['body_text'])
				: (string) $entry['body_html'];
		}

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$state = $this->getPreviewState($emailService->getRegisteredTemplates());
		if ($state['template'] === '') return '';

		$language = $state['language'] ?: null;
		$sampleData = $emailService->getSampleData($state['template'], $language);

		if ($state['format'] === 'text') {
			return $this->renderTextDocument($emailService->renderTextBody($state['template'], $sampleData, $language));
		}

		return $emailService->render($state['template'], $sampleData, $language);
	}

	/**
	 * Wrap a plain text email in an HTML document for the iframe.
	 *
	 * @param string $text
	 * @return string
	 * @throws WireException
	 */
	protected function renderTextDocument(string $text): string
	{
		return '<!DOCTYPE html><html><head><meta charset="utf-8"></head><body>'
			. '<pre style="white-space:pre-wrap;word-break:break-word;font-family:monospace;font-size:14px;padding:20px;margin:0;">'
			. $this->wire('sanitizer')->entities($text)
			. '</pre></body></html>';
	}

	/* ***** Helpers *** */

	/**
	 * Add the breadcrumb to the log overview (only available in the admin).
	 *
	 * @return void
	 * @throws WireException
	 */
	protected function addLogBreadcrumb(): void
	{
		$breadcrumbs = $this->wire('breadcrumbs');
		if ($breadcrumbs instanceof Breadcrumbs) {
			$breadcrumbs->add(new Breadcrumb($this->wire('page')->url, __('Email Log')));
		}
	}

	/**
	 * Show warnings about missing Composer dependencies to superusers.
	 *
	 * @return void
	 * @throws WireException
	 */
	protected function showDependencyWarnings(): void
	{
		if (!$this->wire('user')->isSuperuser()) return;

		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		foreach ($emailService->getDependencyWarnings() as $warning) {
			$this->warning($warning);
		}
	}

	/**
	 * Set the translated title of the admin page in every language that has no
	 * title yet, using the translations of this module ("Email Log").
	 *
	 * @return int Number of languages that got a title
	 * @throws WireException
	 */
	public function translatePageTitle(): int
	{
		/** @var EmailService $emailService */
		$emailService = $this->wire('modules')->get('EmailService');
		$languages = $emailService->getLanguages();
		if (!count($languages)) return 0;

		$moduleId = $this->wire('modules')->getModuleID($this);
		$page = $this->wire('pages')->get("template=admin, process=$moduleId, include=all");
		if (!$page->id) return 0;

		$page->of(false);
		if (!$page->getUnformatted('title') instanceof LanguagesPageFieldValue) return 0;

		$changed = 0;
		foreach ($languages as $language) {
			if ($language->isDefault()) continue;
			if ((string) $page->getLanguageValue($language, 'title') !== '') continue;

			$translated = (string) $emailService->withLanguage($language, fn() => __('Email Log'));
			if ($translated === '' || $translated === 'Email Log') continue;

			$page->setLanguageValue($language, 'title', $translated);
			$changed++;
		}

		if ($changed) $page->save('title', ['quiet' => true]);

		return $changed;
	}

	/**
	 * Set translated page titles after installing.
	 *
	 * @return void
	 * @throws WireException
	 */
	public function ___install(): void
	{
		parent::___install();
		$this->translatePageTitle();
	}

	/**
	 * Set translated page titles when upgrading from < 1.1.0.
	 *
	 * @param int|string $fromVersion
	 * @param int|string $toVersion
	 * @return void
	 * @throws WireException
	 */
	public function ___upgrade($fromVersion, $toVersion): void
	{
		$this->translatePageTitle();
	}

	/**
	 * Database Queries
	 *
	 * @param string $status
	 * @param string $template
	 * @param int $pg
	 * @return array
	 * @throws WireException
	 */
	protected function queryEntries(string $status, string $template, int $pg): array
	{
		try {
			$db = $this->wire('database');
			$offset = ($pg - 1) * self::perPage;

			[$where, $params] = $this->buildWhere($status, $template);

			$stmt = $db->prepare(
				"SELECT `id`, `to_email`, `from_email`, `subject`, `template`, `language`, `status`, `created`
				 FROM `" . EmailService::logTable . "` {$where}
				 ORDER BY `created` DESC
				 LIMIT :limit OFFSET :offset"
			);
			foreach ($params as $k => $v) $stmt->bindValue($k, $v);
			$stmt->bindValue(':limit', self::perPage, \PDO::PARAM_INT);
			$stmt->bindValue(':offset', $offset, \PDO::PARAM_INT);
			$stmt->execute();

			return $stmt->fetchAll(\PDO::FETCH_ASSOC);
		} catch (\Exception $e) {
			$this->wire('log')->save(EmailService::logName, "queryEntries() failed: " . $e->getMessage());
			return [];
		}
	}

	/**
	 * Count total email log entries matching the given filters.
	 *
	 * @param string $status
	 * @param string $template
	 * @return int
	 * @throws WireException
	 */
	protected function queryCount(string $status, string $template): int
	{
		try {
			$db = $this->wire('database');
			[$where, $params] = $this->buildWhere($status, $template);

			$stmt = $db->prepare("SELECT COUNT(*) FROM `" . EmailService::logTable . "` {$where}");
			foreach ($params as $k => $v) $stmt->bindValue($k, $v);
			$stmt->execute();

			return (int) $stmt->fetchColumn();
		} catch (\Exception $e) {
			return 0;
		}
	}

	/**
	 * Delete email log entries matching the given filters.
	 *
	 * @param string $status
	 * @param string $template
	 * @return int Number of deleted rows
	 * @throws WireException
	 */
	protected function deleteEntries(string $status, string $template): int
	{
		try {
			$db = $this->wire('database');
			[$where, $params] = $this->buildWhere($status, $template);

			$stmt = $db->prepare("DELETE FROM `" . EmailService::logTable . "` {$where}");
			foreach ($params as $k => $v) $stmt->bindValue($k, $v);
			$stmt->execute();

			return $stmt->rowCount();
		} catch (\Exception $e) {
			$this->wire('log')->save(EmailService::logName, "deleteEntries() failed: " . $e->getMessage());
			return 0;
		}
	}

	/**
	 * Delete a single email log entry.
	 *
	 * @param int $id
	 * @return bool True if a row was deleted
	 * @throws WireException
	 */
	protected function deleteEntry(int $id): bool
	{
		try {
			$stmt = $this->wire('database')->prepare("DELETE FROM `" . EmailService::logTable . "` WHERE `id` = :id LIMIT 1");
			$stmt->bindValue(':id', $id, \PDO::PARAM_INT);
			$stmt->execute();
			return $stmt->rowCount() > 0;
		} catch (\Exception $e) {
			$this->wire('log')->save(EmailService::logName, "deleteEntry() failed: " . $e->getMessage());
			return false;
		}
	}

	/**
	 * Build a WHERE clause and parameter array from filter values.
	 *
	 * @param string $status
	 * @param string $template
	 * @return array{string, array}
	 */
	private function buildWhere(string $status, string $template): array
	{
		$conditions = [];
		$params = [];

		if ($status !== '') {
			$conditions[] = '`status` = :status';
			$params[':status'] = $status;
		}
		if ($template === '_none') {
			$conditions[] = "`template` = ''";
		} else if ($template !== '') {
			$conditions[] = '`template` = :template';
			$params[':template'] = $template;
		}

		$where = count($conditions) ? 'WHERE ' . implode(' AND ', $conditions) : '';
		return [$where, $params];
	}

	/**
	 * Get distinct template values from the email_log table.
	 *
	 * @return string[]
	 * @throws WireException
	 */
	protected function queryDistinctTemplates(): array
	{
		try {
			$db = $this->wire('database');
			$stmt = $db->query("SELECT DISTINCT `template` FROM `" . EmailService::logTable . "` ORDER BY `template`");
			return $stmt->fetchAll(\PDO::FETCH_COLUMN);
		} catch (\Exception $e) {
			return [];
		}
	}

	/**
	 * Fetch a single email log entry by ID.
	 *
	 * @param int $id
	 * @return array|false
	 * @throws WireException
	 */
	protected function getEntry(int $id): array|false
	{
		try {
			$db = $this->wire('database');
			$stmt = $db->prepare("SELECT * FROM `" . EmailService::logTable . "` WHERE `id` = :id LIMIT 1");
			$stmt->bindValue(':id', $id, \PDO::PARAM_INT);
			$stmt->execute();

			$row = $stmt->fetch(\PDO::FETCH_ASSOC);
			return $row ?: false;
		} catch (\Exception $e) {
			return false;
		}
	}
}
