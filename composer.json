{
    "name": "neuerituale/emailservice",
    "description": "ProcessWire module for templated emails with CSS inlining and logging",
    "type": "processwire-module",
    "keywords": ["processwire", "email", "mail", "templates", "css-inlining"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pelago/emogrifier": "^7.0 || ^8.0"
    },
    "extra": {
        "installer-name": "EmailService"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    }
}
