<?php
namespace ProcessWire;

use Pelago\Emogrifier\CssInliner;

// configuration form and defaults (ProcessWire convention: <ModuleName>Config.php)
require_once __DIR__ . '/EmailServiceConfig.php';

/**
 * Email Service – Templated emails with CSS inlining and logging.
 *
 * Installing this module also installs ProcessEmailLog (admin UI for the log).
 *
 * Other modules register email templates via hook:
 *
 *   wire()->addHookAfter('EmailService::registerTemplates', function(HookEvent $event) {
 *       $service = $event->object;
 *       $service->registerTemplate('welcome', 'Welcome email', [
 *           'userName' => 'Max Mustermann',
 *       ]);
 *   });
 *
 * Multi-language: render(), renderText() and send() accept a language (Language,
 * id or name). The user language is switched while rendering, so __() and
 * multi-language fields in templates return values in that language.
 *
 * @method void registerTemplates()
 * @method string detectTemplate(WireMail $mail)
 *
 * @property string $templatePath Directory of the email templates, relative to the ProcessWire root
 * @property string $wrapperFile
 * @property string $cssFile
 * @property string $defaultFrom
 * @property string $defaultFromName
 * @property int $retainDays
 */
class EmailService extends WireData implements Module, ConfigurableModule {

	/** Name of the ProcessWire log file (site/assets/logs/email-service.txt) */
	const logName = 'email-service';

	/** Name of the database table holding the email log */
	const logTable = 'email_log';

	/** Name of the cron job that prunes old log entries */
	const cleanupJob = 'EmailServiceCleanup';

	/** Class required for CSS inlining (pelago/emogrifier) */
	const inlinerClass = CssInliner::class;

	/** @var array{name: string, label: string, sampleData: array|\Closure}[] */
	public array $registeredTemplates = [];

	/** @var bool Whether the registerTemplates hook has been triggered */
	protected bool $templatesRegistered = false;

	/** @var string|false|null Autoload file that provided the inliner, '' if already loaded, false if not found, null if not checked yet */
	protected string|false|null $inlinerSource = null;

	/** @var bool Whether the missing-inliner warning has been logged in this request */
	protected bool $inlinerWarningLogged = false;


	/**
	 * Return module info array.
	 *
	 * @return array
	 */
	public static function getModuleInfo() {
		return [
			'title' => 'Email Service',
			'summary' => 'Templated emails with CSS inlining and logging',
			'version' => '3.0.1',
			'autoload' => true,
			'singular' => true,
			'icon' => 'envelope',
			'requires' => ['PHP>=8.0', 'ProcessWire>=3.0.0'],
			'installs' => ['ProcessEmailLog'],
		];
	}

	/**
	 * Return default configuration values.
	 *
	 * @return array
	 */
	public function getDefaults(): array {
		return EmailServiceConfig::defaults;
	}

	/**
	 * Set defaults and register the cron job for log cleanup.
	 */
	public function __construct() {
		parent::__construct();

		foreach ($this->getDefaults() as $key => $value) {
			$this->set($key, $value);
		}

		// Cleanup via ProcessCronJobs (if installed); see init() for the LazyCron fallback
		wire()->addHookBefore('ProcessCronJobs::register', function(HookEvent $event) {
			/** @var ProcessCronJobs $cron */
			$cron = $event->object;
			$cron->add(
				self::cleanupJob,
				[$this, 'pruneLogEntries'],
				['lazyCron' => 'everyDay']
			);
		});
	}

	/**
	 * Initialize the module.
	 */
	public function init(): void {
		$this->addHookAfter('WireMail::send', $this, 'hookWireMailSend');

		// cleanup via LazyCron if ProcessCronJobs is not installed (which runs it itself);
		// the hook only fires if LazyCron is installed
		if (!$this->wire('modules')->isInstalled('ProcessCronJobs')) {
			$this->addHookAfter('LazyCron::everyDay', $this, 'pruneLogEntries');
		}
	}

	/**
	 * Log emails sent directly via WireMail (not through EmailService::send).
	 */
	protected function hookWireMailSend(HookEvent $event): void {
		/** @var WireMail $mail */
		$mail = $event->object;
		if ($mail->get('_emailServiceLogged')) return;

		$sent = $event->return > 0;
		$to = implode(', ', $mail->to);
		$from = is_array($mail->from)
			? implode(', ', $mail->from)
			: (string) $mail->from
		;

		$this->writeLogEntry(
			$to,
			$from,
			(string) $mail->subject,
			$this->detectTemplate($mail),
			(string) $mail->bodyHTML,
			(string) $mail->body,
			$sent
		);
	}

	/**
	 * Hookable: determine the template name for a log entry of a mail that was
	 * sent directly via WireMail (e.g. by ProcessForgotPassword).
	 *
	 * Returns an empty string by default. See README for an example.
	 *
	 * @param WireMail $mail
	 * @return string
	 */
	public function ___detectTemplate(WireMail $mail): string {
		return '';
	}

	/* ***** Template Registry *** */

	/**
	 * Hookable: other modules register their email templates here.
	 */
	public function ___registerTemplates(): void {
		// intentionally empty – templates are registered by external modules
	}

	/**
	 * Register an email template with optional sample data for previews.
	 *
	 * Pass a closure as $sampleData to get translated sample values: it is called
	 * in the language that is being previewed, so __() inside returns that language.
	 *
	 * @param string $name Template identifier
	 * @param string $label Human-readable label
	 * @param array|\Closure $sampleData Example data, or a closure returning it
	 */
	public function registerTemplate(string $name, string $label, array|\Closure $sampleData = []): void {
		$this->registeredTemplates[$name] = [
			'name' => $name,
			'label' => $label,
			'sampleData' => $sampleData,
		];
	}

	/**
	 * Get the sample data of a registered template in the given language.
	 *
	 * @param string $name Template identifier
	 * @param Language|int|string|null $language null = current user language
	 * @return array Empty array if the template is not registered or the data is invalid
	 * @throws WireException
	 */
	public function getSampleData(string $name, Language|int|string|null $language = null): array {
		$templates = $this->getRegisteredTemplates();
		if (!isset($templates[$name])) return [];

		$sampleData = $templates[$name]['sampleData'];
		if (is_array($sampleData)) return $sampleData;

		$language = $this->resolveLanguageOrLog($language, "getSampleData('$name')");
		if ($language === false) return [];

		try {
			$data = $this->withLanguage($language, $sampleData);
		} catch (\Throwable $e) {
			$this->wire('log')->save(self::logName, "Sample data of template '$name' failed: " . $e->getMessage());
			return [];
		}

		if (!is_array($data)) {
			$this->wire('log')->save(self::logName, "Sample data closure of template '$name' must return an array, got " . get_debug_type($data));
			return [];
		}
		return $data;
	}

	/**
	 * Get all registered email templates.
	 *
	 * The registerTemplates hook is triggered on first call, so hooks added in
	 * /site/init.php, /site/ready.php or in any module's init()/ready() are included.
	 *
	 * @return array{name: string, label: string, sampleData: array}[]
	 */
	public function getRegisteredTemplates(): array {
		if (!$this->templatesRegistered) {
			$this->templatesRegistered = true;
			$this->registerTemplates();
		}
		return $this->registeredTemplates;
	}

	/* ***** Languages *** */

	/**
	 * Whether multi-language support (LanguageSupport) is available.
	 *
	 * @return bool
	 */
	public function hasLanguageSupport(): bool {
		return $this->wire('languages') instanceof Languages;
	}

	/**
	 * Get all languages, or an empty array without LanguageSupport.
	 *
	 * @return Language[] Indexed by language id
	 */
	public function getLanguages(): array {
		if (!$this->hasLanguageSupport()) return [];
		$items = [];
		foreach ($this->wire('languages') as $language) {
			/** @var Language $language */
			$items[$language->id] = $language;
		}
		return $items;
	}

	/**
	 * Resolve a language argument to a Language.
	 *
	 * @param Language|int|string|null $language Language, id or name
	 * @return Language|null null if no language was given or LanguageSupport is not installed
	 * @throws WireException if the language does not exist
	 */
	public function resolveLanguage(Language|int|string|null $language): ?Language {
		if ($language === null || $language === '' || $language === 0) return null;
		if (!$this->hasLanguageSupport()) return null;

		$languages = $this->wire('languages');
		$found = null;
		try {
			if ($language instanceof Language || is_int($language) || ctype_digit($language)) {
				$id = $language instanceof Language ? $language->id : (int) $language;
				if ($id > 0) $found = $languages->get($id);
			} else {
				// no lenient sanitizing: "../de" must not resolve to "de"
				$name = $this->wire('sanitizer')->pageNameUTF8($language);
				if ($name !== '' && $name === mb_strtolower(trim($language))) $found = $languages->get($name);
			}
		} catch (WireException) {
			$found = null;
		}

		if (!$found instanceof Language || !$found->id) {
			$label = $language instanceof Language ? "#$language->id" : (string) $language;
			throw new WireException("Unknown language: $label");
		}
		return $found;
	}

	/**
	 * Resolve a language, logging instead of throwing.
	 *
	 * @param Language|int|string|null $language
	 * @param string $context Used in the log message
	 * @return Language|null|false false if the language does not exist
	 */
	protected function resolveLanguageOrLog(Language|int|string|null $language, string $context): Language|null|false {
		try {
			return $this->resolveLanguage($language);
		} catch (WireException $e) {
			$this->wire('log')->save(self::logName, "$context: " . $e->getMessage());
			return false;
		}
	}

	/**
	 * Run a callback with the user language temporarily set to $language.
	 *
	 * The previous language is restored afterwards, even if the callback throws.
	 * Calls can be nested.
	 *
	 * @param Language|int|string|null $language null = keep the current language
	 * @param callable $callback
	 * @return mixed Return value of the callback
	 * @throws WireException if the language does not exist
	 */
	public function withLanguage(Language|int|string|null $language, callable $callback): mixed {
		$language = $this->resolveLanguage($language);
		$user = $this->wire('user');
		$previous = $user->get('language');

		if (!$language || ($previous instanceof Language && $previous->id === $language->id)) {
			return $callback();
		}

		$user->setQuietly('language', $language);
		try {
			return $callback();
		} finally {
			$user->setQuietly('language', $previous);
		}
	}

	/* ***** Paths *** */

	/**
	 * Get the absolute path to the email template directory.
	 *
	 * The configured path is relative to the ProcessWire root (e.g. "site/templates/email/"),
	 * so templates can also live outside /site/templates/. A leading slash is allowed.
	 *
	 * @return string Absolute path with trailing slash
	 * @throws WireException
	 */
	public function getTemplatePath(): string {
		return $this->wire('config')->paths->root . $this->normalizeTemplatePath((string) $this->templatePath);
	}

	/**
	 * Normalize a configured template path to a path relative to the ProcessWire root.
	 *
	 * Accepts "site/templates/email", "/site/templates/email/" and the absolute
	 * file system path of a directory inside the root.
	 *
	 * @param string $path
	 * @return string Relative path with trailing slash, or '' for the root itself
	 * @throws WireException
	 */
	protected function normalizeTemplatePath(string $path): string {
		$rootPath = $this->wire('config')->paths->root; // e.g. /var/www/html/
		$path = str_replace('\\', '/', trim($path));
		if ($rootPath !== '/' && str_starts_with($path, $rootPath)) {
			$path = substr($path, strlen($rootPath));
		}
		return $this->normalizeRelativePath($path);
	}

	/**
	 * Normalize a relative path: forward slashes, no empty, "." or ".." segments.
	 *
	 * @param string $path
	 * @return string Path with trailing slash, or '' if nothing is left
	 */
	protected function normalizeRelativePath(string $path): string {
		$path = str_replace('\\', '/', trim($path));
		// no traversal out of the base directory
		$parts = array_filter(explode('/', $path), fn($part) => $part !== '' && $part !== '.' && $part !== '..');
		return count($parts) ? implode('/', $parts) . '/' : '';
	}

	/**
	 * Convert a template path of a version before 2.5.0 to a root-relative path.
	 *
	 * Before 2.5.0 the path was relative to /site/templates/ ("email/"), before 2.2.0
	 * relative to the root with leading slash ("/site/templates/email/").
	 *
	 * @param string $path
	 * @return string Root-relative path
	 * @throws WireException
	 */
	protected function migrateTemplatePath(string $path): string {
		$config = $this->wire('config');
		$templatesUrl = $config->urls->templates; // e.g. /site/templates/
		$path = str_replace('\\', '/', trim($path));

		// < 2.2.0: "/site/templates/email/" (also without a subdirectory install prefix)
		foreach ([$templatesUrl, '/' . ltrim(substr($templatesUrl, strlen($config->urls->root)), '/')] as $prefix) {
			if ($prefix !== '/' && str_starts_with($path, $prefix)) {
				$path = substr($path, strlen($prefix));
				break;
			}
		}

		$absolute = $config->paths->templates . $this->normalizeRelativePath($path);
		return str_starts_with($absolute, $config->paths->root)
			? $this->normalizeRelativePath(substr($absolute, strlen($config->paths->root)))
			: $absolute;
	}

	/* ***** Dependencies *** */

	/**
	 * Get the Composer autoload file of the module (composer install inside the module).
	 *
	 * Installed in the project with Composer, pelago/emogrifier is loaded by the
	 * project autoloader instead, which ProcessWire includes in index.php.
	 *
	 * @return string
	 */
	public function getAutoloadFile(): string {
		return __DIR__ . '/vendor/autoload.php';
	}

	/**
	 * Make sure the CSS inliner is available, loading a Composer autoloader if needed.
	 *
	 * @return bool
	 * @throws WireException
	 */
	public function hasInliner(): bool {
		if ($this->inlinerSource === null) {
			$this->inlinerSource = false;

			if (class_exists(self::inlinerClass)) {
				// already loaded, e.g. by the project autoloader (vendor/autoload.php in the root)
				$this->inlinerSource = '';
			} else {
				$file = $this->getAutoloadFile();
				if (is_file($file)) {
					require_once $file;
					if (class_exists(self::inlinerClass)) $this->inlinerSource = $file;
				}
			}
		}

		return $this->inlinerSource !== false;
	}

	/**
	 * Get warnings about missing Composer dependencies.
	 *
	 * @return string[] Empty if everything is installed
	 * @throws WireException
	 */
	public function getDependencyWarnings(): array {
		$warnings = [];

		if (!$this->hasInliner()) {
			$warnings[] = sprintf(
				$this->_('EmailService: pelago/emogrifier is not installed, CSS is not inlined. Run %1$s in %2$s or %3$s in the project root.'),
				'composer install --no-dev',
				__DIR__,
				'composer require pelago/emogrifier'
			);
		}

		return $warnings;
	}

	/**
	 * Get a human-readable status of the CSS inliner dependency.
	 *
	 * @return string
	 * @throws WireException
	 */
	public function getInlinerStatus(): string {
		if (!$this->hasInliner()) {
			return sprintf(
				$this->_('pelago/emogrifier not found: neither loaded by the project autoloader nor in %s. CSS will be embedded in a style block instead of being inlined.'),
				$this->getAutoloadFile()
			);
		}

		if ($this->inlinerSource === '') {
			return $this->_('pelago/emogrifier is available (already loaded).');
		}

		return sprintf($this->_('pelago/emogrifier is available (loaded from %s).'), $this->inlinerSource);
	}

	/* ***** Sending *** */

	/**
	 * Send a templated email.
	 *
	 * @param array $options {to, from, fromName, subject, template, data, cc, bcc, language}
	 * @return bool True if the email was sent successfully
	 * @throws WireException
	 */
	public function send(array $options): bool {
		$defaults = [
			'to' => '',
			'from' => $this->defaultFrom ?: ($this->wire('config')->adminEmail ?? ''),
			'fromName' => $this->defaultFromName ?: '',
			'subject' => '',
			'template' => '',
			'data' => [],
			'cc' => '',
			'bcc' => '',
			'language' => null,
		];
		$options = array_merge($defaults, $options);

		if (empty($options['to']) || empty($options['template'])) {
			return false;
		}

		$language = $this->resolveLanguageOrLog($options['language'], 'send()');
		if ($language === false) return false;

		$data = array_merge(['subject' => $options['subject']], (array) $options['data']);

		[$html, $text] = $this->withLanguage($language, function() use ($options, $data) {
			$html = $this->render($options['template'], $data);
			if ($html === '') return ['', ''];
			$text = $this->renderText($options['template'], $data) ?: $this->htmlToText($html);
			return [$html, $text];
		});
		if ($html === '') return false;

		$to = is_array($options['to']) ? implode(', ', $options['to']) : (string) $options['to'];
		$mail = $this->wire('mail')->new();
		$sent = $this->sendMail($mail, $to, function(WireMail $mail) use ($options, $html, $text) {
			$mail->to($options['to']);
			$mail->from($options['from'], $options['fromName']);
			$mail->subject($options['subject']);
			$mail->bodyHTML($html);
			$mail->body($text);

			$this->addCopyRecipients($mail, 'cc', $options['cc']);
			$this->addCopyRecipients($mail, 'bcc', $options['bcc']);
		});

		// the language the email was rendered in (the current user language if none was given)
		$usedLanguage = $language ?: ($this->hasLanguageSupport() ? $this->wire('user')->get('language') : null);

		$this->writeLogEntry(
			$to,
			$this->usedFrom($mail, (string) $options['from']),
			(string) $options['subject'],
			(string) $options['template'],
			$html,
			$text,
			$sent,
			$usedLanguage instanceof Language ? $usedLanguage->name : ''
		);

		return $sent;
	}

	/**
	 * Add CC or BCC recipients.
	 *
	 * Uses $mail->cc()/bcc() if the mailer provides them (e.g. WireMailSmtp).
	 * The core WireMail has no such methods, so the header is set instead.
	 *
	 * @param WireMail $mail
	 * @param string $type 'cc' or 'bcc'
	 * @param string|array $emails Comma-separated string or array of addresses
	 * @throws WireException
	 */
	protected function addCopyRecipients(WireMail $mail, string $type, string|array $emails): void {
		$sanitizer = $this->wire('sanitizer');
		$list = is_array($emails) ? $emails : explode(',', $emails);
		$list = array_values(array_unique(array_filter(array_map(
			fn($email) => $sanitizer->email(trim((string) $email)),
			$list
		))));
		if (!count($list)) return;

		if (method_exists($mail, $type) || method_exists($mail, "___$type")) {
			$mail->$type($list);
			if ($type === 'cc') $this->enableCopyDelivery($mail);
		} else {
			$mail->header($type === 'cc' ? 'Cc' : 'Bcc', implode(', ', $list));
		}
	}

	/**
	 * Make sure CC recipients are delivered by mailers that send one message per recipient.
	 *
	 * WireMailSmtp sends a separate message to every TO address and ignores CC, unless
	 * sendSingle(true) is set. That only works with a single TO address, with more
	 * recipients CC is not possible and a warning is logged.
	 *
	 * @param WireMail $mail
	 */
	protected function enableCopyDelivery(WireMail $mail): void {
		if (!method_exists($mail, 'sendSingle')) return;

		if (count((array) $mail->get('to')) === 1) {
			$mail->sendSingle(true);
			return;
		}

		$this->wire('log')->save(self::logName, sprintf(
			'%s ignores CC recipients when sending to more than one TO address, CC was not sent.',
			wireClassName($mail)
		));
	}

	/**
	 * Build and send a mail; exceptions of the mail module count as a failed send.
	 *
	 * The mail is marked, so the WireMail::send hook doesn't log it a second time.
	 *
	 * @param WireMail $mail
	 * @param string $to Recipients for the error message
	 * @param callable $build Sets the recipients, subject and body of the mail
	 * @return bool True if at least one message was sent
	 */
	protected function sendMail(WireMail $mail, string $to, callable $build): bool {
		$mail->set('_emailServiceLogged', true);
		try {
			$build($mail);
			return $mail->send() > 0;
		} catch (\Exception $e) {
			$this->wire('log')->save(self::logName, sprintf(
				'Sending to %s via %s failed: %s',
				$to,
				wireClassName($mail),
				$e->getMessage()
			));
			return false;
		}
	}

	/**
	 * The sender the mail module actually uses, it may replace the given one
	 * (e.g. WireMailSmtp with "force sender" or an empty from address).
	 *
	 * @param WireMail $mail
	 * @param string $fallback Given sender, used if the mail has none (e.g. it failed before from() was set)
	 * @return string
	 */
	protected function usedFrom(WireMail $mail, string $fallback): string {
		$from = $mail->get('from');
		if (is_array($from)) $from = implode(', ', $from);
		return (string) $from !== '' ? (string) $from : $fallback;
	}

	/**
	 * Resend an email directly from a stored log entry (used by ProcessEmailLog).
	 *
	 * @param array $entry Row from the email log table
	 * @return bool
	 * @throws WireException
	 */
	public function resend(array $entry): bool {
		$mail = $this->wire('mail')->new();
		$sent = $this->sendMail($mail, (string) $entry['to_email'], function(WireMail $mail) use ($entry) {
			$mail->to($entry['to_email']);
			$mail->from($entry['from_email'], $this->defaultFromName ?: '');
			$mail->subject($entry['subject']);
			$mail->bodyHTML($entry['body_html']);
			$mail->body($entry['body_text']);
		});

		$this->writeLogEntry(
			$entry['to_email'],
			$this->usedFrom($mail, (string) $entry['from_email']),
			$entry['subject'],
			$entry['template'],
			$entry['body_html'],
			$entry['body_text'],
			$sent,
			(string) ($entry['language'] ?? '')
		);

		return $sent;
	}

	/* ***** Rendering *** */

	/**
	 * Render an email template with wrapper and CSS inlining.
	 *
	 * @param string $template Template name (without .php extension)
	 * @param array $data Variables passed to the template
	 * @param Language|int|string|null $language Language to render in, null = current user language
	 * @return string Rendered HTML, or '' if the template or the language does not exist
	 * @throws WireException
	 */
	public function render(string $template, array $data = [], Language|int|string|null $language = null): string {
		$language = $this->resolveLanguageOrLog($language, "render('$template')");
		if ($language === false) return '';
		return $this->withLanguage($language, fn() => $this->renderHtml($template, $data));
	}

	/**
	 * Render the HTML of a template in the current language.
	 *
	 * @param string $template
	 * @param array $data
	 * @return string
	 * @throws WireException
	 */
	protected function renderHtml(string $template, array $data): string {
		$basePath = $this->getTemplatePath();

		$contentFile = $this->getTemplateFile($template, '.php');
		if (!$contentFile) {
			$this->wire('log')->save(self::logName, "Template not found: {$basePath}{$template}.php");
			return '';
		}
		$content = $this->renderFile($contentFile, $data);

		$wrapperFile = $basePath . $this->wrapperFile;
		if (!$this->wrapperFile || !is_file($wrapperFile)) {
			return $content;
		}
		$html = $this->renderFile($wrapperFile, array_merge($data, ['content' => $content]));

		$cssFile = $basePath . $this->cssFile;
		if ($this->cssFile && is_file($cssFile)) {
			$html = $this->applyCss($html, (string) file_get_contents($cssFile));
		}

		return $html;
	}

	/**
	 * Render the plain-text version of a template if available.
	 *
	 * @param string $template Template name
	 * @param array $data Variables passed to the template
	 * @param Language|int|string|null $language Language to render in, null = current user language
	 * @return string Plain text or empty string if no text template exists
	 * @throws WireException
	 */
	public function renderText(string $template, array $data = [], Language|int|string|null $language = null): string {
		$textFile = $this->getTemplateFile($template, '.txt.php');
		if (!$textFile) return '';
		$language = $this->resolveLanguageOrLog($language, "renderText('$template')");
		if ($language === false) return '';
		return $this->withLanguage($language, function() use ($textFile, $data) {
			$text = trim($this->renderFile($textFile, $data));
			$wrapperFile = $this->getTextWrapperFile();
			if ($wrapperFile === '') return $text;
			return trim($this->renderFile($wrapperFile, array_merge($data, ['content' => $text])));
		});
	}

	/**
	 * Get the wrapper for plain text emails: the wrapper file with .txt.php instead
	 * of .php (wrapper.php → wrapper.txt.php), e.g. for a signature with the sender address.
	 *
	 * Text generated from the HTML (no .txt.php template) already contains the HTML
	 * wrapper, so this is only used for .txt.php templates.
	 *
	 * @return string Absolute file, or '' if there is none
	 * @throws WireException
	 */
	public function getTextWrapperFile(): string {
		$wrapper = (string) $this->wrapperFile;
		if (!str_ends_with($wrapper, '.php') || str_ends_with($wrapper, '.txt.php')) return '';
		$file = $this->getTemplatePath() . substr($wrapper, 0, -4) . '.txt.php';
		return is_file($file) ? $file : '';
	}

	/**
	 * Render the text part exactly as send() would: the .txt.php template if it
	 * exists, otherwise text generated from the HTML.
	 *
	 * @param string $template Template name
	 * @param array $data Variables passed to the template
	 * @param Language|int|string|null $language Language to render in, null = current user language
	 * @return string Plain text, or '' if the template or the language does not exist
	 * @throws WireException
	 */
	public function renderTextBody(string $template, array $data = [], Language|int|string|null $language = null): string {
		if ($this->hasTextTemplate($template)) {
			return $this->renderText($template, $data, $language);
		}
		$html = $this->render($template, $data, $language);
		return $html === '' ? '' : $this->htmlToText($html);
	}

	/**
	 * Whether a template exists (name.php).
	 *
	 * @param string $template
	 * @return bool
	 * @throws WireException
	 */
	public function hasTemplate(string $template): bool {
		return $this->getTemplateFile($template, '.php') !== '';
	}

	/**
	 * Whether a template has its own plain-text version (name.txt.php).
	 *
	 * @param string $template
	 * @return bool
	 * @throws WireException
	 */
	public function hasTextTemplate(string $template): bool {
		return $this->getTemplateFile($template, '.txt.php') !== '';
	}

	/**
	 * Get the absolute file of a template, or '' if it does not exist.
	 *
	 * @param string $template Template name, may contain subdirectories (e.g. "shop/order")
	 * @param string $suffix
	 * @return string
	 * @throws WireException
	 */
	protected function getTemplateFile(string $template, string $suffix): string {
		$name = $this->normalizeRelativePath($template);
		if ($name === '') return '';
		$file = $this->getTemplatePath() . rtrim($name, '/') . $suffix;
		return is_file($file) ? $file : '';
	}

	/**
	 * Inline CSS into the HTML, or embed it as <style> block if the inliner is missing.
	 *
	 * @param string $html
	 * @param string $css
	 * @return string
	 * @throws WireException
	 */
	protected function applyCss(string $html, string $css): string {
		if ($css === '') return $html;

		if ($this->hasInliner()) {
			$inliner = self::inlinerClass;
			return $inliner::fromHtml($html)->inlineCss($css)->render();
		}

		if (!$this->inlinerWarningLogged) {
			$this->inlinerWarningLogged = true;
			$this->wire('log')->save(self::logName, 'pelago/emogrifier not found, CSS embedded as <style> block.');
		}

		$style = "<style>\n" . $css . "\n</style>";
		if (stripos($html, '</head>') !== false) {
			return preg_replace('~</head>~i', $style . "\n</head>", $html, 1);
		}
		return $style . "\n" . $html;
	}

	/**
	 * Render a single template file with the given data.
	 *
	 * @param string $file Absolute file path
	 * @param array $data Variables passed to the template
	 * @return string Rendered output
	 */
	protected function renderFile(string $file, array $data): string {
		$template = new TemplateFile($file);
		$template->setArray($data);

		// TemplateFile leaves its output buffer open if the template throws
		$level = ob_get_level();
		try {
			return $template->render();
		} catch (\Throwable $e) {
			while (ob_get_level() > $level) ob_end_clean();
			throw $e;
		}
	}

	/**
	 * Convert HTML to plain text by stripping tags and normalizing whitespace.
	 *
	 * @param string $html
	 * @return string
	 */
	protected function htmlToText(string $html): string {
		$text = preg_replace('~<(head|style|script)\b.*?</\1>~is', '', $html);
		$text = preg_replace('/<br\s*\/?>/i', "\n", $text);
		$text = preg_replace('/<\/p>/i', "\n\n", $text);
		$text = preg_replace('/<\/tr>/i', "\n", $text);
		$text = preg_replace('/<\/h[1-6]>/i', "\n\n", $text);
		$text = strip_tags($text);
		$text = html_entity_decode($text, ENT_QUOTES, 'UTF-8');
		$text = preg_replace('/[ \t]+/', ' ', $text);
		$text = preg_replace('/ *\n */', "\n", $text);
		$text = preg_replace('/\n{3,}/', "\n\n", $text);
		return trim($text);
	}

	/* ***** Logging *** */

	/**
	 * Write an entry into the email log table.
	 *
	 * @param string $to
	 * @param string $from
	 * @param string $subject
	 * @param string $template
	 * @param string $html
	 * @param string $text
	 * @param bool $sent
	 * @param string $language Name of the language the email was rendered in
	 * @throws WireException
	 */
	protected function writeLogEntry(
		string $to,
		string $from,
		string $subject,
		string $template,
		string $html,
		string $text,
		bool $sent,
		string $language = ''
	): void {
		try {
			$db = $this->wire('database');
			$stmt = $db->prepare(
				"INSERT INTO `" . self::logTable . "`
				 (`to_email`, `from_email`, `subject`, `template`, `language`, `body_html`, `body_text`, `status`, `created`)
				 VALUES (:to_email, :from_email, :subject, :template, :language, :body_html, :body_text, :status, :created)"
			);
			$stmt->execute([
				':to_email' => mb_substr($to, 0, 255),
				':from_email' => mb_substr($from, 0, 255),
				':subject' => mb_substr($subject, 0, 255),
				':template' => mb_substr($template, 0, 128),
				':language' => mb_substr($language, 0, 128),
				':body_html' => $html,
				':body_text' => $text,
				':status' => $sent ? 'sent' : 'failed',
				':created' => time(),
			]);
		} catch (\Exception $e) {
			$this->wire('log')->save(self::logName, "writeLogEntry() failed: " . $e->getMessage());
		}
	}

	/**
	 * Delete email log entries older than the configured retention period.
	 */
	public function pruneLogEntries(): void {
		$retainDays = (int) $this->retainDays;
		if ($retainDays <= 0) return;

		try {
			$db = $this->wire('database');
			$threshold = time() - ($retainDays * 86400);
			$stmt = $db->prepare("DELETE FROM `" . self::logTable . "` WHERE `created` < :threshold");
			$stmt->execute([':threshold' => $threshold]);
			$deleted = $stmt->rowCount();
			if ($deleted > 0) {
				$this->wire('log')->save(self::logName,
					"Pruned {$deleted} email log entries older than {$retainDays} days.");
			}
		} catch (\Exception $e) {
			$this->wire('log')->save(self::logName, "pruneLogEntries() failed: " . $e->getMessage());
		}
	}

	/* ***** Install / Upgrade / Uninstall *** */

	/**
	 * Create the email log table on module install.
	 * ProcessEmailLog is installed afterwards via the 'installs' module info.
	 */
	public function ___install(): void {
		$this->createLogTable();

		foreach ($this->getDependencyWarnings() as $warning) {
			$this->warning($warning);
		}

		$path = $this->getTemplatePath();
		if (!is_dir($path)) {
			$this->warning(sprintf(
				$this->_('Email template directory %s does not exist yet. Examples: %s'),
				$path,
				__DIR__ . '/examples/email/'
			));
		}
	}

	/**
	 * Bring existing installations up to date.
	 *
	 * @param int|string $fromVersion
	 * @param int|string $toVersion
	 * @throws WireException
	 */
	public function ___upgrade($fromVersion, $toVersion): void {
		$this->createLogTable();

		// < 2.4.0: the log did not store the language
		if ($this->addLogLanguageColumn()) {
			$this->message("EmailService: column 'language' added to the email log");
		}

		// < 2.1.0: ProcessEmailLog had to be installed manually
		$modules = $this->wire('modules');
		if (!$modules->isInstalled('ProcessEmailLog') && $modules->isInstallable('ProcessEmailLog', true)) {
			$modules->install('ProcessEmailLog');
			$this->message('Installed ProcessEmailLog');
		}

		// < 2.6.0: the Composer autoload file was configurable
		$data = $modules->getConfig($this);
		if (array_key_exists('autoloadFile', $data)) {
			unset($data['autoloadFile']);
			$modules->saveConfig($this, $data);
		}

		// < 2.5.0: templatePath was relative to /site/templates/ (< 2.2.0: "/site/templates/email/"),
		// now it is relative to the root
		$from = $modules->formatVersion($fromVersion);
		$data = $modules->getConfig($this);
		if (version_compare($from, '2.5.0', '<') && isset($data['templatePath'])) {
			$migrated = $this->migrateTemplatePath((string) $data['templatePath']);
			if ($migrated !== $data['templatePath']) {
				$data['templatePath'] = $migrated;
				$modules->saveConfig($this, $data);
				$this->set('templatePath', $migrated);
				$this->message("EmailService: templatePath migrated to '$migrated'");
			}
		}
	}

	/**
	 * Drop the email log table on module uninstall.
	 * ProcessEmailLog is uninstalled automatically since it requires this module.
	 */
	public function ___uninstall(): void {
		$this->wire('database')->exec("DROP TABLE IF EXISTS `" . self::logTable . "`;");
	}

	/**
	 * Add the language column to email log tables created before 2.4.0.
	 *
	 * Note: ALTER TABLE ends a running database transaction.
	 *
	 * @return bool True if the column was added
	 */
	protected function addLogLanguageColumn(): bool {
		$database = $this->wire('database');
		$stmt = $database->prepare("SHOW COLUMNS FROM `" . self::logTable . "` LIKE 'language'");
		$stmt->execute();
		$exists = (bool) $stmt->fetch();
		$stmt->closeCursor();
		if ($exists) return false;

		$database->exec(
			"ALTER TABLE `" . self::logTable . "`"
			. " ADD COLUMN `language` VARCHAR(128) NOT NULL DEFAULT '' AFTER `template`"
		);
		return true;
	}

	/**
	 * Create the email log table if it does not exist yet.
	 */
	protected function createLogTable(): void {
		$this->wire('database')->exec("
			CREATE TABLE IF NOT EXISTS `" . self::logTable . "` (
				`id`         INT UNSIGNED NOT NULL AUTO_INCREMENT,
				`to_email`   VARCHAR(255) NOT NULL DEFAULT '',
				`from_email` VARCHAR(255) NOT NULL DEFAULT '',
				`subject`    VARCHAR(255) NOT NULL DEFAULT '',
				`template`   VARCHAR(128) NOT NULL DEFAULT '',
				`language`   VARCHAR(128) NOT NULL DEFAULT '',
				`body_html`  MEDIUMTEXT   NULL,
				`body_text`  MEDIUMTEXT   NULL,
				`status`     ENUM('sent','failed') NOT NULL DEFAULT 'sent',
				`created`    INT UNSIGNED NOT NULL,
				PRIMARY KEY (`id`),
				KEY `idx_status` (`status`),
				KEY `idx_template` (`template`),
				KEY `idx_created` (`created`)
			) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
		");
	}
}
